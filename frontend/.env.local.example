# Configuración de Supabase - Frontend
# Copia este archivo a .env.local y reemplaza los valores con los tuyos

# URL de tu proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública de Supabase (anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anonima-aqui

# Service Role Key (solo para servidor, NUNCA lo expongas en el cliente)
# Esta clave se usa en las API routes del servidor Next.js
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
